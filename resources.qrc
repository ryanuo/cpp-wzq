<RCC>
    <!-- alias 必须显式指定: <file>res/x.jpg</file> 的默认资源路径是 res/x.jpg,
         加前缀 /res 后变成 :/res/res/x.jpg, 与代码 :/res/x.jpg 不匹配 -->
    <qresource prefix="/res">
        <file alias="board_1_cream.png">res/board_1_cream.png</file>
        <file alias="board_2_mint.png">res/board_2_mint.png</file>
        <file alias="board_3_peach.png">res/board_3_peach.png</file>
        <file alias="board_4_wood.png">res/board_4_wood.png</file>
        <file alias="black.png">res/black.png</file>
        <file alias="white.png">res/white.png</file>
        <file alias="start.wav">res/start.wav</file>
        <file alias="down.wav">res/down.wav</file>
        <file alias="bg.mp3">res/bg.mp3</file>
        <file alias="win.mp3">res/win.mp3</file>
        <file alias="lose.mp3">res/lose.mp3</file>
        <file alias="win.jpg">res/win.jpg</file>
        <file alias="lose.jpg">res/lose.jpg</file>
    </qresource>
</RCC>
